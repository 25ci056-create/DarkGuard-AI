# ── DarkGuard AI · Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret

# SQLite database path (relative to project root)
DATABASE_PATH=darkguard.db

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JS origins: http://localhost:5000
# Authorized redirect URIs: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Apple Sign In ─────────────────────────────────────────────────────────────
# Requires Apple Developer account + paid membership
# https://developer.apple.com/documentation/sign_in_with_apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:5000/api/auth/apple/callback

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_LIFETIME_DAYS=1
REMEMBER_ME_DAYS=30

# ── Upload ────────────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=30
DELETE_UPLOADS_AFTER_AUDIT=true
